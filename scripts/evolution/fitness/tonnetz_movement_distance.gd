static func get_distance(anchor_a, anchor_b) -> float:
	if anchor_a == null or anchor_b == null:
		push_error("Cannot measure Tonnetz distance for null anchor.")
		return 0.0

	if anchor_a == anchor_b:
		return 0.0

	if anchor_a is TonnetzNode and anchor_b is TonnetzNode:
		return _get_table_distance(_get_node_key(anchor_a), _get_node_key(anchor_b), NODE_INDEX, NODE_DISTANCES)

	if anchor_a is TonnetzTriangle and anchor_b is TonnetzTriangle:
		return _get_table_distance(_get_triangle_key(anchor_a), _get_triangle_key(anchor_b), TRIANGLE_INDEX, TRIANGLE_DISTANCES)

	push_error("Cannot measure Tonnetz distance between different anchor types.")
	return 0.0

static func _get_table_distance(anchor_key_a: String, anchor_key_b: String, index_table: Dictionary, distance_table: Array) -> float:
	if not index_table.has(anchor_key_a) or not index_table.has(anchor_key_b):
		push_error("Cannot measure Tonnetz distance for anchors outside the distance table: %s -> %s" % [
			anchor_key_a,
			anchor_key_b
		])
		return 0.0

	var index_a: int = int(index_table[anchor_key_a])
	var index_b: int = int(index_table[anchor_key_b])
	return float(distance_table[index_a][index_b])

static func _get_node_key(node: TonnetzNode) -> String:
	return "n:%d,%d" % [node.q, node.r]

static func _get_triangle_key(triangle: TonnetzTriangle) -> String:
	var coords: Array[Vector2i] = []

	for node in triangle.nodes:
		coords.append(Vector2i(node.q, node.r))

	coords.sort()

	var node_keys := PackedStringArray()
	for coord in coords:
		node_keys.append("%d,%d" % [coord.x, coord.y])

	return "t:" + ";".join(node_keys)
